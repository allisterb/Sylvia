<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="testappsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Compile Include="TestsRuntime.fs" />
    <Compile Include="DisplayTests.fs" />
    <Compile Include="ParserTests.fs" />
    <Compile Include="KernelProofTests.fs" />
    <Compile Include="SatChainTests.fs" />
    <Compile Include="QuantifierKernelTests.fs" />
    <Compile Include="PredCalculusTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\base\Sylvia.Runtime.Fs\Sylvia.Runtime.Fs.fsproj" />
    <ProjectReference Include="..\..\src\lang\core\Sylvia.Prover\Sylvia.Prover.fsproj" />
    <!-- SatChainTests exercises SAT.rupChain and SatProof's pure clause plumbing. The end-to-end
         `prove` tests need the cadical executable and SKIP THEMSELVES when it is absent, so
         neither reference makes the suite depend on an external binary. -->
    <ProjectReference Include="..\..\src\lang\solvers\Sylvia.Solver.CaDiCaL\Sylvia.Solver.CaDiCaL.fsproj" />
    <ProjectReference Include="..\..\src\lang\core\Sylvia.Prover.SAT\Sylvia.Prover.SAT.fsproj" />
  </ItemGroup>

</Project>